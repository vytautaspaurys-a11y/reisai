# ============================================================
# ŠABLONAS — nukopijuok į .env ir įrašyk savo reikšmes.
# Šis failas GALI būti GitHub'e (čia nėra tikrų raktų).
# ============================================================

# --- Supabase (naršyklei, Vite) ---
# Dashboard → Project Settings → API
# URL: Project URL
# Project ID: Project Settings → General → Reference ID
# Raktas: anon / public (senesniuose projektuose) arba publishable (naujesniuose)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_ANON_KEY=

# --- Vercel (internete) ---
# Tie patys trys kintamieji įrašomi Vercel Dashboard:
# Project → Settings → Environment Variables
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PROJECT_ID
#   VITE_SUPABASE_ANON_KEY
# Vercel pats sukuria VERCEL, VERCEL_ENV, VERCEL_URL — jų čia nerašyk.

# --- Resend (tik laiškams, NE naršyklei) ---
# Niekada nepridėk VITE_ priešdėlio — kitaip raktas patektų į svetainę.
# Šie raktai gyvena tik Supabase → Edge Functions → Secrets
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM_EMAIL=Reisai <noreply@tavo-domenas.lt>
# Vietiniam Edge Function paleidimui tuos pačius gali įrašyti į supabase/.env
